      "id": "sj1pbq83vc40",
      "name": "Atlassian Community - Access Issue for Jira Product Discovery Resources",
      "status": "identified",
      "created_at": "2026-09-23T12:44:32.042Z",
      "updated_at": "2026-09-23T16:47:57.978Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "major",
      "shortlink": "https://stspg.io/fzr1jrj552jb",
      "started_at": "2026-09-23T12:44:32.032Z",
      "page_id": "3tbw4lb9t3qp",
      "incident_updates": [
        {
          "id": "7gkkwpt72grw",
          "status": "identified",
          "body": "Our teams continue to work on a mitigation. Affected users may experience access issues for community group and discussion links. We will continue to share additional updates here as more information becomes available.",
          "incident_id": "sj1pbq83vc40",
          "created_at": "2026-09-23T16:47:57.976Z",
          "updated_at": "2026-09-23T16:47:57.976Z",
          "display_at": "2026-09-23T16:47:57.976Z",
          "affected_components": [
            {
              "code": "x6ljwvfs3ymn",
              "name": "Community",
              "old_status": "partial_outage",
              "new_status": "partial_outage"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "cv80snvy5cpz",
          "status": "identified",
          "body": "We have deployed a configuration fix, which has restored access to key Jira Product Discovery articles, FAQs, the public roadmap, and the product handbook.\n\nOur engineering team is continuing to work on resolving access for the remaining community group and discussion links.\n\nWe will provide another update in 2 hours, or sooner if we make further progress.",
          "incident_id": "sj1pbq83vc40",
          "created_at": "2026-09-23T14:41:42.741Z",
          "updated_at": "2026-09-23T14:41:42.741Z",
          "display_at": "2026-09-23T14:41:42.741Z",
          "affected_components": [
            {
              "code": "x6ljwvfs3ymn",
              "name": "Community",
              "old_status": "partial_outage",
              "new_status": "partial_outage"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "qjdyjry2cw27",
          "status": "identified",
          "body": "We have identified an issue affecting access to Jira Product Discovery community and support resources on Atlassian Community.\n\nImpacted users may encounter errors or broken links when attempting to access the Jira Product Discovery discussion group, articles, FAQs, or related documentation.\n\nOur engineering teams are actively working on a resolution. We will provide our next update in 2 hours, or as soon as we have a material update.",
          "incident_id": "sj1pbq83vc40",
          "created_at": "2026-09-23T12:44:32.159Z",
          "updated_at": "2026-09-23T12:44:32.159Z",
