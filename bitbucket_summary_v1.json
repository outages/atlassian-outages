      "page_id": "bqlf8qjztdtr",
      "incident_updates": [
        {
          "id": "fj09z2fk25nv",
          "status": "identified",
          "body": "Our teams continue to work on recovery until the incident is fully resolved. We will provide further updates if we have significant progress to share.\n\nAlong with impact to scheduled and asynchronous work across several products, we also identified SLA component in Jira Service Management is not appearing as expected.",
