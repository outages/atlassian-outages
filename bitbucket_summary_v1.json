      "id": "79qnbz42j9s9",
      "name": "Bitbucket Cloud - Database Maintenance",
      "status": "scheduled",
      "created_at": "2026-09-24T03:29:11.713Z",
      "updated_at": "2026-09-24T17:09:47.986Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "maintenance",
      "shortlink": "https://stspg.io/pb8cfz8038zd",
      "started_at": "2026-09-24T03:29:11.700Z",
      "page_id": "bqlf8qjztdtr",
      "incident_updates": [
        {
          "id": "n3v4k3h4wymq",
          "status": "scheduled",
          "body": "Note: This is the maintenance originally scheduled for October 3rd, which has now been rescheduled to October 10th.\n\nBitbucket will be performing required maintenance on our database infrastructure for 30 minutes on Saturday, October 10th, 2026 at 16:00 UTC. The maintenance will require a short period of downtime at the beginning of the maintenance window, affecting all Bitbucket Cloud services including the Bitbucket website, Git operations via SSH and HTTPS, API requests, and Bitbucket Pipelines. Performance degradation is possible throughout the window. We encourage all of our users to plan their operations around this window.",
          "incident_id": "79qnbz42j9s9",
          "created_at": "2026-09-24T03:29:11.815Z",
          "updated_at": "2026-09-24T17:09:47.981Z",
